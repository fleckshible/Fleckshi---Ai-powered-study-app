{
  "name": "fleckshi",
  "version": "2.2.1",
  "description": "Fleckshi — Your study space, guided.",
  "author": "Fleckshi",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:pack": "node scripts/desktop-build.mjs --pack",
    "desktop:build": "node scripts/desktop-build.mjs"
  },
  "build": {
    "appId": "com.fleckshi.app",
    "productName": "Fleckshi",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fleckshi",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Fleckshi-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Fleckshi-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@google/genai": "^3.5.0",
    "animejs": "^4.5.0",
    "dompurify": "^3.4.18",
    "katex": "^0.19.1",
    "marked": "^18.2.1",
    "motion": "^12.43.0",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "running": "^0.0.1",
    "vite": "^6.0.0"
  }
}
